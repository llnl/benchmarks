# simple test of fcc Cu with ACE product

units           metal
atom_style      atomic

neighbor        0.3 bin
neigh_modify    every 1 delay 0 check yes

variable        a equal 3.597
lattice         fcc $a
variable        Lprime index 64.0
variable        nscale index 1.0
variable        pacechunksize index 32768
variable        L equal ${Lprime}*(${nscale})^(1/3)
region          box block 0 ${L} 0 ${L} 0 ${L}
create_box      1 box
create_atoms    1 box

mass            1 63.546

displace_atoms  all random 0.001 0.001 0.001 12345 units box

# Some systems buffer extensively
thermo_modify   flush yes

velocity        all create 300 8728 loop geom
timestep        0.0005

pair_style      soft 2.5
pair_coeff      * * 0.0
variable        pre equal ramp(0,100)
fix             push all adapt 1 pair soft a * * v_pre
fix             lim all nve/limit 0.05
thermo          100
run             1000
unfix           push
unfix           lim
reset_timestep  0

pair_style      pace product chunksize ${pacechunksize}
pair_coeff      * * Cu-PBE-core-rep.ace Cu
min_style       cg
minimize        1e-4 1e-4 1000 10000
reset_timestep  0

compute         eatom all pe/atom
compute         energy all reduce sum c_eatom
variable        delenergy equal c_energy-pe

compute         satom all stress/atom NULL
compute         str all reduce sum c_satom[1] c_satom[2] c_satom[3]
variable        delpress equal -(c_str[1]+c_str[2]+c_str[3])/(3*vol)-press

thermo          100
thermo_style    custom step cpu spcpu temp epair etotal press v_delenergy v_delpress

##################################
### Benchmarking modifications ###
##################################

# Add a thermostat to keep temperature from falling
fix mynvt       all nvt temp 300.0 300.0 $(100.0*dt)

# Print out the value of L for parsing ease
print "The value of L is $L" 
print " Weak scaling factor (nscale) = ${nscale}"
print " Baseline L (Lprime) = ${Lprime}"
print " Simulation cell length (L) = ${L}"
print " PACE Chunk Size (pacechunksize) = ${pacechunksize}"

### Throw out first 5 minutes for hardware equilibrium

# Stop after 5.5 minutes
fix             2 all halt 10 tlimit > 330.0 message no error continue
run             10000000

### Run another 5 minutes for final FOM
unfix           2

# Stop after 5.5 minutes
fix             3 all halt 10 tlimit > 330.0 message no
run             10000000
